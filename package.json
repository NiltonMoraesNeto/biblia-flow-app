{
  "name": "biblia-flow-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.0",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^10.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:navigation",
    "validate:structure": "node scripts/validate-structure.mjs",
    "check": "npm run validate:structure && npm run typecheck && npm run lint && npm run format:check && npm test",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "test:unit": "node --test tests/*.test.mjs",
    "test:navigation": "jest --runInBand"
  },
  "private": true,
  "engines": {
    "node": ">=24.3.0 <25"
  }
}
